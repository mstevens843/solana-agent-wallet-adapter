# Copy this file to .env and fill in your own endpoints.
# The app loads .env automatically from the current working directory,
# and SOLANA_RPC_URL or HELIUS_RPC_URL overrides rpcUrl in agent-wallet.config.json.

SOLANA_RPC_URL=https://your-mainnet-rpc.example
HELIUS_RPC_URL=
HELIUS_API_KEY=
PARSE_TRANSACTIONS_API=
PARSE_TRANSACTION_HISTORY_API=
SENDER_RPC_URL=
JUPITER_API_KEY=
JUP_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_TOKENS_BASE_URL=https://api.jup.ag/tokens/v2
JUPITER_PRICE_BASE_URL=https://api.jup.ag/price/v3
JUPITER_PORTFOLIO_BASE_URL=https://api.jup.ag/portfolio/v1
JUPITER_SEND_BASE_URL=https://api.jup.ag/send/v1
JUPITER_STUDIO_BASE_URL=https://api.jup.ag/studio/v1
JUPITER_TX_BASE_URL=https://api.jup.ag/tx/v1
JUP_ULTRA_BASE=https://api.jup.ag/swap/v2
JUPITER_API_URL=https://quote-api.jup.ag
# Jupiter Prediction (beta, read-only). Override to point at a staging endpoint if needed.
# The runtime feature flag lives in agent-wallet.config.json under connectors.jupiter.prediction.enabled.
JUPITER_PREDICTION_BASE_URL=https://api.jup.ag/prediction/v1
# Jupiter Perps (read-only research). No default; opt in only when the official Perps API stabilizes.
# Status reads work without this URL; account snapshots remain unsupported_method until set.
# JUPITER_PERPS_BASE_URL=
# Sanctum, Magic Eden, Tensor, and Lulo use a per-user BYO-API-key model in
# the cloud workspace (Connectors UX). Each user pastes their own key via the
# Connectors panel; the cloud persists it per-wallet and injects it at prepare
# time.
#
# The local bridge (single-user) can still fall back to env vars for solo dev:
# uncomment and fill if you run the bridge directly without the cloud workspace.
# SANCTUM_API_KEY=
# SANCTUM_API_BASE_URL=https://sanctum-api.ironforge.network
# SANCTUM_CONNECTOR_ENABLED=true
# MAGICEDEN_API_KEY=
# MAGICEDEN_API_BASE_URL=https://api-mainnet.magiceden.dev/v2
# MAGICEDEN_CONNECTOR_ENABLED=true
# TENSOR_API_KEY=
# TENSOR_API_BASE_URL=https://api.mainnet.tensordev.io/api/v1
# LULO_API_KEY=
# LULO_API_BASE_URL=https://api.lulo.fi

# Cloud-only: encryption KEK for per-user connector secrets. 32+ bytes.
# Required in production. Non-production can fall back to SESSION_SECRET.
# Never commit a real value.
# CONNECTOR_SECRET_KEY=
BIRDEYE_API_KEY=
BIRDEYE_REST_BASE=https://public-api.birdeye.so
BIRDEYE_WS_URL=
BIRDEYE_WS_ENABLED=false
BIRDEYE_CHAIN=solana
COINGECKO_API_KEY=
COINGECKO_REST_BASE=https://pro-api.coingecko.com/api/v3
BRIDGE_TOKEN=local-agent-wallet
REOWN_PROJECT_ID=
WALLETCONNECT_STORAGE_DIR=./.agent-wallet/walletconnect

# --- Policy orchestrator + multilingual policy layer ---
# The agent-review pipeline pre-resolves user policy rules into structured "atoms" and,
# for non-English rules, detects the language and canonicalizes the text into English
# before extraction. If a non-English rule cannot be safely canonicalized, the review
# fails CLOSED (decision = needs_input) on every surface (web, CLI, Android, iOS, hosted).
#
# AGENT_WALLET_POLICY_ORCHESTRATOR=0 disables the WHOLE orchestrator (atoms + language).
# Leave unset/enabled in production. Setting it to 0 returns an empty bundle and the LLM
# reviews over raw prose.
# AGENT_WALLET_POLICY_ORCHESTRATOR=1
#
# AGENTIC_POLICY_TRANSLATION=0 disables ONLY the MCP server's model-backed canonicalization
# fallback (used when the deterministic phrase-pack cannot canonicalize a non-English rule).
# With it off, such rules fail closed to needs_input instead of asking the model to translate.
# The BYOK cloud-enrich path (/api/policy/enrich) has no model fallback by design and always
# fails closed; only the hosted-managed MCP review path uses this fallback.
# AGENTIC_POLICY_TRANSLATION=1
#
# AGENTIC_REVIEW_LOCALIZATION=0 disables only the post-review model translation pass
# for non-English display copy. Phrase-pack label/prose localization still runs.
# AGENTIC_REVIEW_LOCALIZATION=1
VITE_AGENTIC_APP_SURFACE=public
VITE_AGENTIC_GA_MEASUREMENT_ID=
