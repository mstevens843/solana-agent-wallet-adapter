# Copy this file to .env and fill in your own endpoints.
# The app loads .env automatically from the current working directory,
# and SOLANA_RPC_URL or HELIUS_RPC_URL overrides rpcUrl in agent-wallet.config.json.

SOLANA_RPC_URL=https://your-mainnet-rpc.example
HELIUS_RPC_URL=
JUPITER_API_KEY=
JUP_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_TOKENS_BASE_URL=https://api.jup.ag/tokens/v2
JUPITER_PRICE_BASE_URL=https://api.jup.ag/price/v3
JUP_ULTRA_BASE=https://api.jup.ag/swap/v2
JUPITER_API_URL=https://quote-api.jup.ag
# Jupiter Prediction (beta, read-only). Override to point at a staging endpoint if needed.
# The runtime feature flag lives in agent-wallet.config.json under connectors.jupiter.prediction.enabled.
JUPITER_PREDICTION_BASE_URL=https://api.jup.ag/prediction/v1
# Jupiter Perps (read-only research). No default; opt in only when the official Perps API stabilizes.
# Status reads work without this URL; account snapshots remain unsupported_method until set.
# JUPITER_PERPS_BASE_URL=
SANCTUM_API_KEY=
SANCTUM_API_BASE_URL=https://sanctum-api.ironforge.network
SANCTUM_CONNECTOR_ENABLED=true
BIRDEYE_API_KEY=
BIRDEYE_REST_BASE=https://public-api.birdeye.so
BRIDGE_TOKEN=local-agent-wallet
REOWN_PROJECT_ID=
WALLETCONNECT_STORAGE_DIR=./.agent-wallet/walletconnect
VITE_AGENTIC_APP_SURFACE=public
VITE_AGENTIC_GA_MEASUREMENT_ID=
