{
  "name": "@solana-agent-wallet-adapter/skills-cli",
  "version": "0.0.1-dev",
  "description": "Skills authoring CLI: agentic-skill init|test|publish.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentic-skill": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/*.js",
    "dist/*.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -F @solana-agent-wallet-adapter/skills-runtime build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm -F @solana-agent-wallet-adapter/skills-runtime build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -F @solana-agent-wallet-adapter/skills-runtime build && vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@solana-agent-wallet-adapter/skills-runtime": "workspace:*",
    "@solana-agent-wallet-adapter/workflow": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
