{
  "name": "@solana-agent-wallet-adapter/ios-link",
  "version": "0.0.1",
  "description": "iOS universal-link and WalletConnect signing transport for Solana Agent Wallet Adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deeplink": {
      "types": "./dist/deeplink.d.ts",
      "import": "./dist/deeplink.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -F @solana-agent-wallet-adapter/core build && tsc -p tsconfig.json",
    "typecheck": "pnpm -F @solana-agent-wallet-adapter/core build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana-agent-wallet-adapter/core": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "@walletconnect/sign-client": "^2.23.10",
    "bs58": "^6.0.0",
    "lokijs": "^1.5.12",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
