{
  "name": "@solana-agent-wallet-adapter/mcp-server",
  "version": "0.0.1",
  "description": "MCP server that routes Solana agent signing through the user's real wallet with explicit approval.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "solana-agent-wallet-mcp": "./dist/bin/server.js",
    "solana-agent-wallet-bridge": "./dist/bin/bridge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana-agent-wallet-adapter/core": "workspace:*",
    "@solana-agent-wallet-adapter/ios-link": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
