{
  "name": "@solana-agent-wallet-adapter/mcp-server",
  "version": "0.0.1",
  "description": "MCP server that routes Solana agent signing through the user's real wallet with explicit approval.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "solana-agent-wallet-mcp": "./dist/bin/server.js",
    "solana-agent-wallet-bridge": "./dist/bin/bridge.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -F @solana-agent-wallet-adapter/workflow build && pnpm -F @solana-agent-wallet-adapter/core build && pnpm -F @solana-agent-wallet-adapter/ios-link build && tsc -p tsconfig.json",
    "typecheck": "pnpm -F @solana-agent-wallet-adapter/workflow build && pnpm -F @solana-agent-wallet-adapter/core build && pnpm -F @solana-agent-wallet-adapter/ios-link build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana-agent-wallet-adapter/core": "workspace:*",
    "@solana-agent-wallet-adapter/ios-link": "workspace:*",
    "@solana-agent-wallet-adapter/workflow": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "decimal.js": "^10.6.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@jito-foundation/stake-deposit-interceptor-sdk": "1.7.1",
    "@kamino-finance/farms-sdk": "^3.2.24",
    "@kamino-finance/klend-sdk": "^7.3.22",
    "@kamino-finance/scope-sdk": "^10.2.2",
    "@marinade.finance/marinade-ts-sdk": "5.0.18",
    "@meteora-ag/dlmm": "1.9.7",
    "@mrgnlabs/marginfi-client-v2": "6.4.1",
    "@mrgnlabs/mrgn-common": "2.0.7",
    "@orca-so/whirlpools": "2.2.0",
    "@pythnetwork/pyth-solana-receiver": "0.8.2",
    "@raydium-io/raydium-sdk-v2": "0.1.126-alpha",
    "@solana/kit": "2.3.0",
    "@solana/spl-stake-pool": "1.1.8",
    "@solana/spl-token": "0.4.14",
    "@solendprotocol/solend-sdk": "^0.14.27",
    "rpc-websockets": "^8.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
