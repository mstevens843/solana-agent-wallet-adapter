{
  "name": "@solana-agent-wallet-adapter/walletconnect-solana",
  "version": "0.0.1",
  "description": "WalletConnect v2 Solana adapter exposed as a Wallet Standard wallet — for QR pairing with Phantom / Solflare mobile on the Tauri desktop shell.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana/wallet-standard-features": "^1.4.0",
    "@solana/web3.js": "^1.95.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@walletconnect/sign-client": "^2.23.10",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
