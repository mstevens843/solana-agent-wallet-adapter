{
  "name": "@solana-agent-wallet-adapter/workflow",
  "version": "0.0.1",
  "description": "Shared Agentic Cloud workflow contracts and validators.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -F @solana-agent-wallet-adapter/ap2-adapter build && pnpm -F @solana-agent-wallet-adapter/acp-adapter build && pnpm -F @solana-agent-wallet-adapter/mpp-adapter build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana-agent-wallet-adapter/ap2-adapter": "workspace:*",
    "@solana-agent-wallet-adapter/acp-adapter": "workspace:*",
    "@solana-agent-wallet-adapter/mpp-adapter": "workspace:*"
  }
}
