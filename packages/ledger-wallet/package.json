{
  "name": "@solana-agent-wallet-adapter/ledger-wallet",
  "version": "0.0.1",
  "description": "Ledger USB-HID hardware-wallet adapter exposed as a Solana Wallet Standard wallet. Pairs with the Tauri shell's `ledger_*` IPC commands (hidapi + Ledger HID framing + Solana APDU).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhid": {
      "types": "./dist/webhid.d.ts",
      "import": "./dist/webhid.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ledgerhq/hw-app-solana": "^7.10.2",
    "@ledgerhq/hw-transport-webhid": "^6.35.2",
    "@solana/wallet-standard-features": "^1.3.0",
    "@solana/web3.js": "^1.95.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.1"
  }
}
