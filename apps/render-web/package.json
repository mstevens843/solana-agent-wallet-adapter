{
  "name": "@solana-agent-wallet-adapter/render-web",
  "version": "0.0.1",
  "private": true,
  "description": "Same-origin Render web server for Agentic hosted BYOK planning.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "pnpm -F @solana-agent-wallet-adapter/mcp-server build && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@solana-agent-wallet-adapter/mcp-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
