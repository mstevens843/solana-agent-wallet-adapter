<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Apple Privacy Manifest (required for App Store submission since May 1, 2024).
    Declares Agentic's tracking posture + which "Required Reason APIs" the app
    uses and why. Each Required Reason API needs an entry from Apple's approved
    code list, or submission gets rejected.

    Sources reviewed when filling this in:
      - apps/ios-native/Sources/AgenticNativeIOS/AgenticAuthCache.swift
        uses UserDefaults as a fallback bucket when Keychain rejects writes
        (category CA92.1: app's own bucket for own purposes).
      - Firebase AnalyticsCore provides baseline native app measurement.
        Agentic disables tracking, ad personalization, and IDFA-capable
        Firebase Analytics support; wallet sessions remain user-initiated
        and scoped to the dApp.

    When adding APIs (e.g., file-timestamp readers, system-boot-time,
    disk-space) in the future, add a matching NSPrivacyAccessedAPIType dict
    here. Apple's policy: keep this manifest accurate or risk rejection.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!--
                    CA92.1: Access to UserDefaults that the app reads/writes
                    for its own purposes. Used by AgenticAuthCache.swift as a
                    Keychain fallback bucket for the device-local auth record
                    when the secure enclave isn't available.
                -->
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!--
                    C617.1: Access timestamps of files within the app's own
                    bundle/container. Used by AgenticRemoteConfigStore.swift
                    for cache invalidation and by structured logging
                    timestamps.
                -->
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!--
                    35F9.1: Measure time within app/process (debounce timers,
                    refresh windows, request latency).
                -->
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!--
                    E174.1: Write to / read from the app's own container while
                    caching remote config + streaming session state.
                -->
                <string>E174.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
