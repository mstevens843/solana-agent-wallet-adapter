{
  "name": "@solana-agent-wallet-adapter/desktop-shell",
  "version": "0.2.1",
  "private": true,
  "description": "Agentic desktop runtime for Solana Agent Wallet Adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1 --port 5175",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  },
  "dependencies": {
    "@solana-agent-wallet-adapter/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
