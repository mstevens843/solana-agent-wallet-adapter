{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Agentic desktop main window.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://agentic-signer.com", "https://agentic-signer.com/*"]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:resources:default",
    "notification:default",
    "deep-link:default"
  ]
}
