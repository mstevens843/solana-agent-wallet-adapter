{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-commands",
  "description": "Grants the app-defined Tauri commands to the main window for both the bundled (tauri://localhost) and the live-loaded Render origin. Required because registering an app ACL manifest (build.rs) makes every app command ACL-gated, and Tauri 2 rejects custom commands from a remote origin unless explicitly granted here. Keep in sync with build.rs / the generate_handler! list in src/lib.rs.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://agentic-signer.com", "https://agentic-signer.com/*"]
  },
  "permissions": [
    "allow-read-config",
    "allow-save-config",
    "allow-read-runtime-setup",
    "allow-save-runtime-setup",
    "allow-bridge-status",
    "allow-start-bridge",
    "allow-stop-bridge",
    "allow-restart-bridge",
    "allow-read-logs",
    "allow-secure-get",
    "allow-secure-set",
    "allow-secure-delete",
    "allow-read-env-keys",
    "allow-write-env-keys",
    "allow-open-external-url",
    "allow-wallet-status",
    "allow-wallet-create",
    "allow-wallet-import",
    "allow-wallet-unlock",
    "allow-wallet-lock",
    "allow-wallet-change-password",
    "allow-wallet-sign-message",
    "allow-wallet-sign-transaction",
    "allow-wallet-set-auto-lock",
    "allow-wallet-export-for-backup",
    "allow-wallet-delete",
    "allow-ledger-list-devices",
    "allow-ledger-connect",
    "allow-ledger-get-address",
    "allow-ledger-get-addresses",
    "allow-ledger-sign-transaction",
    "allow-ledger-sign-message",
    "allow-ledger-disconnect"
  ]
}
