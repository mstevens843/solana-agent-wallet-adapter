{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic",
  "version": "0.3.0",
  "identifier": "com.agentic.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @solana-agent-wallet-adapter/browser-demo dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm --filter @solana-agent-wallet-adapter/browser-demo build",
    "frontendDist": "../../browser-demo/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agentic",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Agentic desktop runtime for Solana Agent Wallet Adapter."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agentic"]
      }
    }
  }
}
