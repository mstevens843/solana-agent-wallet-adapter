{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic",
  "version": "0.2.0",
  "identifier": "com.agentic.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Agentic desktop runtime for Solana Agent Wallet Adapter."
  }
}
