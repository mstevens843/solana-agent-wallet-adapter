{
  "name": "solana-agent-wallet-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "MWA for AI agents. MCP signing bridge plus framework integrations that let agents transact on Solana through the user's actual wallet, no custody.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
