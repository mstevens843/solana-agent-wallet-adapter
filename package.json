{
  "name": "solana-agent-wallet-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Real-wallet adapter for Solana AI agents. Route MCP and framework signing through the user's installed wallet, no custody.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "node scripts/dev.mjs --mobile",
    "dev:trace": "AGENT_WALLET_TRACE=1 node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "cli": "node packages/cli/dist/index.js",
    "desktop:dev": "pnpm -F @solana-agent-wallet-adapter/desktop-shell dev",
    "desktop:tauri:dev": "pnpm -F @solana-agent-wallet-adapter/desktop-shell tauri:dev",
    "desktop:tauri:build": "pnpm -F @solana-agent-wallet-adapter/desktop-shell tauri:build",
    "android:build": "node scripts/android.mjs build",
    "android:debug": "node scripts/android.mjs debug",
    "android:release": "node scripts/android.mjs release",
    "android:install": "node scripts/android.mjs install",
    "android:fingerprint": "node scripts/android.mjs fingerprint",
    "android:assetlinks": "node scripts/android.mjs assetlinks",
    "android:assetlinks:write": "node scripts/android.mjs assetlinks:write",
    "android:assetlinks:verify": "node scripts/android.mjs assetlinks:verify",
    "android:assetlinks:check-live": "node scripts/android.mjs assetlinks:check-live",
    "android:assetlinks:diagnose": "node scripts/android.mjs assetlinks:diagnose",
    "android:test": "node scripts/android.mjs test",
    "android:instrumented-test": "node scripts/android.mjs instrumented-test",
    "ios:mode": "node scripts/ios.mjs mode",
    "ios:build": "node scripts/ios.mjs build",
    "ios:debug": "node scripts/ios.mjs debug",
    "ios:release": "node scripts/ios.mjs release",
    "ios:sync": "node scripts/ios.mjs sync",
    "ios:live": "node scripts/ios.mjs live",
    "ios:local": "node scripts/ios.mjs local",
    "ios:open": "node scripts/ios.mjs open",
    "render:prepare": "node scripts/prepare-render-site.mjs",
    "render:build": "pnpm render:prepare && pnpm -F @solana-agent-wallet-adapter/browser-demo typecheck && pnpm -F @solana-agent-wallet-adapter/browser-demo build && node scripts/verify-browser-dist.mjs && node scripts/write-spa-route-fallbacks.mjs && pnpm -F @solana-agent-wallet-adapter/render-web build && pnpm smoke:render-web",
    "mcp:codex:add": "node scripts/codex-mcp.mjs add",
    "mcp:codex:remove": "node scripts/codex-mcp.mjs remove",
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm build:packages && pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" lint",
    "test": "pnpm -r test",
    "test:packages": "pnpm -r --filter \"./packages/*\" test",
    "demo:web": "pnpm demo:browser",
    "smoke:web": "vite",
    "smoke:render-web": "node scripts/smoke-render-web.mjs",
    "smoke:render-web:layout": "node scripts/smoke-render-web.mjs --layout",
    "smoke:render-web:workflow": "node scripts/smoke-render-web.mjs --workflow",
    "smoke:render-web:live": "node scripts/smoke-render-web.mjs --live",
    "smoke:render-web:ap2": "node scripts/smoke-render-web.mjs --ap2",
    "smoke:render-web:ap2-live": "node scripts/smoke-render-web.mjs --ap2 --live",
    "smoke:render-web:skills": "node scripts/smoke-render-web.mjs --skills",
    "smoke:render-web:skills-live": "node scripts/smoke-render-web.mjs --skills --live",
    "demo:browser": "VITE_AGENTIC_APP_SURFACE=public pnpm -F @solana-agent-wallet-adapter/browser-demo dev",
    "demo:browser:debug": "VITE_AGENTIC_APP_SURFACE=debug pnpm -F @solana-agent-wallet-adapter/browser-demo dev",
    "demo:browser:build": "pnpm --filter @solana-agent-wallet-adapter/browser-demo^... build && pnpm -F @solana-agent-wallet-adapter/browser-demo typecheck && pnpm -F @solana-agent-wallet-adapter/browser-demo build && node scripts/verify-browser-dist.mjs && node scripts/write-spa-route-fallbacks.mjs",
    "demo:agent": "pnpm -F reference-agent dev",
    "demo:agent:build": "pnpm -F reference-agent build",
    "verify:release-links": "node scripts/verify-release-links.mjs",
    "verify:release-links:live": "node scripts/verify-release-links.mjs --live",
    "verify:production-app": "node scripts/verify-production-app.mjs",
    "security:audit": "pnpm audit --prod",
    "hooks:install": "lefthook install",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": "1.14.4",
      "@hono/node-server@<1.19.15": "1.19.15",
      "fast-uri": "^3.1.5",
      "hono": "^4.12.34",
      "ip-address": "^10.3.1",
      "@solana/web3.js@1.77.4>rpc-websockets": "7.7.0",
      "@kamino-finance/farms-sdk": "3.2.24",
      "ai@<6.0.191": "6.0.191",
      "axios@<0.33.0": "0.33.0",
      "axios@>=1.0.0 <1.18.0": "1.18.0",
      "bn.js@<4.12.3": "4.12.3",
      "bn.js@>=5.0.0 <5.2.3": "5.2.3",
      "body-parser@>=1.0.0 <1.20.6": "1.20.6",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "esbuild@<=0.24.2": "0.25.12",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "joi@<17.13.4": "17.13.4",
      "jsondiffpatch@<0.7.2": "0.7.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "langsmith@<0.6.0": "0.6.0",
      "marked@<4.0.10": "4.0.10",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "protobufjs@<7.6.5": "7.6.5",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "shell-quote@<=1.8.4": "1.9.0",
      "svgo@>=4.0.0 <4.0.2": "4.0.2",
      "tar@<=7.5.21": "7.5.21",
      "tmp@<0.2.7": "0.2.7",
      "uuid@<11.1.1": "11.1.1",
      "valibot@<1.4.2": "1.4.2",
      "vite@<=6.4.2": "6.4.3",
      "vitest@<4.1.1": "4.1.1",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "packageExtensions": {
      "@metaplex-foundation/mpl-core@0.6.1": {
        "dependencies": {
          "borsh": "0.7.0"
        }
      }
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2025-3194",
        "CVE-2025-14505",
        "CVE-2025-71329",
        "CVE-2025-71330"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "lefthook": "2.1.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.1"
  }
}
